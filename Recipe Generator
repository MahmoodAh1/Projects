@app.route("/api/recipes/search")
def search_recipes():
    q=trim(request.args.get("q","")); cuisine=trim(request.args.get("cuisine",""))
    meal=trim(request.args.get("meal_type","")); page=max(1,int(request.args.get("page",1)))
    per_page=20; offset=(page-1)*per_page
    where="WHERE 1=1"; params=[]
    if q: where+=" AND r.name LIKE %s"; params.append(f"%{q}%")
    if cuisine: where+=" AND c.name=%s"; params.append(cuisine)
    if meal: where+=" AND r.meal_type=%s"; params.append(meal)
    total_row=fetch_one(f"SELECT COUNT(*) FROM recipes r JOIN cuisines c ON c.id=r.cuisine_id {where}",tuple(params))
    total=int(total_row[0]) if total_row else 0
    rows=fetch_all(f"""SELECT r.id,r.name,c.name,COALESCE(r.meal_type,''),r.servings
        FROM recipes r JOIN cuisines c ON c.id=r.cuisine_id
        {where} ORDER BY r.name LIMIT %s OFFSET %s""", tuple(params)+(per_page,offset))
    return jsonify({"results":[{"id":r[0],"name":r[1],"cuisine":r[2],"meal_type":r[3],"servings":r[4]} for r in rows],
                    "total":total,"page":page,"per_page":per_page,
                    "pages":max(1,(total+per_page-1)//per_page)})

