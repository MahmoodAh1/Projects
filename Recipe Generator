@app.route("/api/daily-plan")
def daily_plan():
    cuisine = trim(request.args.get("cuisine", ""))
    dessert_cuisine = trim(request.args.get("dessert_cuisine", "")) or None
    include_dessert = request.args.get("include_dessert", "false").lower() == "true"

    # If no cuisine specified, pick random
    if not cuisine:
        row = fetch_one("SELECT DISTINCT c.name FROM cuisines c JOIN recipes r ON r.cuisine_id = c.id ORDER BY RAND() LIMIT 1")
        cuisine = row[0] if row else "Italian"

    plan = {"cuisine": cuisine}
    user_id = session.get("user_id")

    for mt in ("Breakfast", "Lunch", "Dinner"):
        row = fetch_one("""SELECT r.id, r.name FROM recipes r JOIN cuisines c ON c.id=r.cuisine_id
            WHERE c.name=%s AND r.meal_type=%s ORDER BY RAND() LIMIT 1""", (cuisine, mt))
        meal_data = {"id": int(row[0]), "name": row[1]} if row else {"id": None, "name": "(none found)"}
