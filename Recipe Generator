# ── Ingredient match ───────────────────────────────────────────
@app.route("/api/match-ingredients", methods=["POST"])
def match_ingredients():
    data = request.get_json(force=True) or {}
    raw_ings = data.get("ingredients", [])
    cuisine = trim(data.get("cuisine", ""))
    user_id = session.get("user_id")

    if len(raw_ings) < 2: return jsonify({"error": "Please add at least 2 ingredients"}), 400
    if not cuisine: return jsonify({"error": "Please select a cuisine"}), 400

    typed_lc = {to_lower(normalize_to_canonical(r)) for r in raw_ings}
    pantry_lc = set()
    if user_id:
        rows = fetch_all("SELECT LOWER(canonical_name) FROM pantry_items WHERE user_id=%s", (user_id,))
        pantry_lc = {r[0] for r in rows}
    have_lc = pantry_lc | typed_lc
    have_list = sorted(have_lc)

    best_id = find_best_match_recipe_id(cuisine, have_list)
    if best_id == -1:
        return jsonify({"error": f"No match found in '{cuisine}'. Try more ingredients or a different cuisine."}), 404

    recipe = load_recipe_full(best_id)
    if not recipe: return jsonify({"error": "Recipe not found"}), 404
    if user_id: execute("INSERT INTO history(user_id,recipe_id) VALUES(%s,%s)", (user_id, best_id))

    recipe_canonicals = [to_lower(i["canonical_name"]) for i in recipe["ingredients"]]
    provided = []
    for db_ing in recipe_canonicals:
        for ui in have_lc:
            if word_match(ui, db_ing): provided.append(db_ing); break

    missing_ings = [i for i in recipe["ingredients"]
                    if not any(word_match(u, to_lower(i["canonical_name"])) for u in have_lc)]

    recipe["provided"] = provided
    recipe["missing"] = [{"display_name": i["display_name"], "qty_display": i["qty_display"]}
                         for i in missing_ings]
    recipe["match_count"] = len(provided)
    recipe["total_ing"] = len(recipe["ingredients"])
    # Pass typed ingredients back so the frontend can use them for shopping list
    recipe["typed_ingredients"] = list(typed_lc)
    recipe["have_lc"] = list(have_lc)

    return jsonify(recipe)

