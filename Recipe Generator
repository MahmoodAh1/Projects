# ── DB helpers ────────────────────────────────────────────────
def get_conn():
    return mysql.connector.connect(**DB_CONFIG)

def fetch_all(sql, params=()):
    conn = get_conn(); cur = conn.cursor()
    cur.execute(sql, params); rows = cur.fetchall()
    cur.close(); conn.close(); return rows

def fetch_one(sql, params=()):
    conn = get_conn(); cur = conn.cursor()
    cur.execute(sql, params); row = cur.fetchone()
    cur.close(); conn.close(); return row

def execute(sql, params=()):
    conn = get_conn(); cur = conn.cursor()
    cur.execute(sql, params); conn.commit()
    lid = cur.lastrowid; cur.close(); conn.close(); return lid

# ── Utilities ─────────────────────────────────────────────────
def trim(s): return (s or "").strip()
def to_lower(s): return (s or "").strip().lower()

def normalize_to_canonical(raw):
    x = to_lower(trim(raw))
    if not x: return ""
    row = fetch_one("SELECT canonical_name FROM ingredient_aliases WHERE alias_lc=%s", (x,))
    if row: return row[0]
    row = fetch_one("SELECT canonical_name FROM ingredient_catalog WHERE canonical_lc=%s", (x,))
    if row: return row[0]
    execute("INSERT IGNORE INTO ingredient_catalog(canonical_name,category) VALUES(%s,'Other')", (x,))
    row = fetch_one("SELECT canonical_name FROM ingredient_catalog WHERE canonical_lc=%s", (x,))
    return row[0] if row else x

def ingredient_matches(user_ing, db_ing):
    db_clean = re.sub(r'^[\s\d./,]+', '', db_ing).strip()
    return bool(re.search(r'\b' + re.escape(user_ing) + r'\b', db_clean))

def word_match(user_ing, db_ing):
    return bool(re.search(r'\b' + re.escape(user_ing) + r'\b', db_ing.lower()))

def convert_to_grams(amount, unit):
    if not amount or float(amount) <= 0: return None
    u = to_lower(unit)
    if u in ("g","gram","grams"): return float(amount)
    if u in ("kg","kilogram","kilograms"): return float(amount) * 1000
    if u in ("mg","milligram","milligrams"): return float(amount) / 1000
    return None

def load_recipe_full(recipe_id):
    row = fetch_one("""
        SELECT r.id, r.cuisine_id, c.name, r.name,
               COALESCE(r.instructions,''), r.servings, COALESCE(r.meal_type,'')
        FROM recipes r JOIN cuisines c ON c.id=r.cuisine_id
        WHERE r.id=%s
    """, (recipe_id,))
    if not row: return None
    rid, cid, cuisine, name, instructions, servings, meal_type = row

    ing_rows = fetch_all("""
        SELECT i.name,
               COALESCE(ia.canonical_name, ic2.canonical_name, i.name),
               COALESCE(ic.category,'Other'),
               COALESCE(i.amount,0), COALESCE(i.unit,''),
               COALESCE(i.quantity_text,''), i.importance
        FROM ingredients i
        LEFT JOIN ingredient_aliases ia ON ia.alias_lc=i.name_lc
        LEFT JOIN ingredient_catalog ic2 ON ic2.canonical_lc=i.name_lc
        LEFT JOIN ingredient_catalog ic ON ic.canonical_name=COALESCE(ia.canonical_name,ic2.canonical_name,i.name)
        WHERE i.recipe_id=%s ORDER BY i.id
    """, (rid,))

    ingredients = []
    for r in ing_rows:
        dn, cn, cat, amt, unit, qty_txt, imp = r
        amt = float(amt or 0)
        if qty_txt: qty_display = qty_txt
        elif amt > 0 and unit: qty_display = f"{amt:g} {unit}"
        else: qty_display = "(qty not set)"
        ingredients.append({"display_name":dn,"canonical_name":cn,"category":cat,
                             "amount":amt,"unit":unit,"quantity_text":qty_txt,
                             "qty_display":qty_display,"importance":int(imp)})

    return {"id":int(rid),"cuisine_id":int(cid),"cuisine":cuisine,"name":name,
            "instructions":instructions,"servings":int(servings),
            "meal_type":meal_type,"ingredients":ingredients}

def find_best_match_recipe_id(cuisine_name, user_lc_list):
    if not cuisine_name or not user_lc_list: return -1
    rows = fetch_all("""
        SELECT r.id,
               LOWER(COALESCE(ia.canonical_name,ic2.canonical_name,i.name)) AS ing_name
        FROM recipes r
        JOIN cuisines c ON c.id=r.cuisine_id
        JOIN ingredients i ON i.recipe_id=r.id
        LEFT JOIN ingredient_aliases ia ON ia.alias_lc=i.name_lc
        LEFT JOIN ingredient_catalog ic2 ON ic2.canonical_lc=i.name_lc
        WHERE c.name=%s
    """, (cuisine_name,))
    if not rows: return -1

    recipe_ings = defaultdict(set)
    for rid, ing in rows:
        recipe_ings[int(rid)].add(ing)

    def score(threshold):
        res = []
        for rid, ings in recipe_ings.items():
            matched = sum(1 for ui in user_lc_list if any(ingredient_matches(ui, di) for di in ings))
            if matched >= threshold: res.append((rid, matched))
        return res

    best = score(3) or score(2)
    if not best: return -1
    best.sort(key=lambda x: x[1], reverse=True)
    return random.choice(best[:5])[0]

def compute_nutrition(recipe, servings_wanted):
    scale = servings_wanted / max(1, recipe["servings"])
    cal=prot=carb=fat=0.0; any_ok=False; skipped=[]
    for ing in recipe["ingredients"]:
        g = convert_to_grams(ing["amount"] * scale, ing["unit"])
        if g is None: skipped.append(ing["display_name"]); continue
        row = fetch_one("""SELECT calories_per_100,protein_per_100,carbs_per_100,fat_per_100
                           FROM ingredient_nutrition WHERE canonical_name=%s""", (ing["canonical_name"],))
        if not row: skipped.append(f"{ing['display_name']} (no data)"); continue
        f = g / 100
        cal+=float(row[0])*f; prot+=float(row[1])*f
        carb+=float(row[2])*f; fat+=float(row[3])*f; any_ok=True
    return {"calories":round(cal,1),"protein":round(prot,1),"carbs":round(carb,1),
            "fat":round(fat,1),"any_computed":any_ok,"skipped":skipped}

def get_random_dessert(cuisine_name=None):
    pattern = r'cake|pie|tart|ice cream|cookie|brownie|pudding|dessert|custard|sorbet|gelato|torte|bar'
    if cuisine_name:
        row = fetch_one("""SELECT r.id FROM recipes r JOIN cuisines c ON c.id=r.cuisine_id
                           WHERE c.name=%s AND (r.meal_type='Snack' OR LOWER(r.name) REGEXP %s)
                           ORDER BY RAND() LIMIT 1""", (cuisine_name, pattern))
    else:
        row = fetch_one("""SELECT r.id FROM recipes r
                           WHERE r.meal_type='Snack' OR LOWER(r.name) REGEXP %s
                           ORDER BY RAND() LIMIT 1""", (pattern,))
    return int(row[0]) if row else None

