# ── Budget estimate ────────────────────────────────────────────
@app.route("/api/budget/<int:recipe_id>")
def budget_estimate(recipe_id):
    """
    Mirrors app2.py budget_estimate():
    Compares missing ingredients against ingredient_prices for a given store,
    sums unit prices, and lists items with no price data.
    """
    store = trim(request.args.get("store", ""))
    if not store:
        return jsonify({"error": "Store name is required"}), 400

    user_id = session.get("user_id")
    # Build have_lc from pantry + any extra passed ingredients
    pantry_lc = set()
    if user_id:
        rows = fetch_all("SELECT LOWER(canonical_name) FROM pantry_items WHERE user_id=%s", (user_id,))
        pantry_lc = {r[0] for r in rows}

    extra_have = request.args.get("have_lc", "")
    if extra_have:
        for item in extra_have.split(","):
            item = item.strip()
            if item:
                pantry_lc.add(item)

    recipe = load_recipe_full(recipe_id)
    if not recipe: return jsonify({"error": "Recipe not found"}), 404

    total = 0.0
    no_price = []
    items_priced = []

    for ing in recipe["ingredients"]:
        if to_lower(ing["canonical_name"]) in pantry_lc:
            continue  # user already has this ingredient
        price_row = fetch_one(
            "SELECT price, unit FROM ingredient_prices WHERE store=%s AND canonical_name=%s",
            (store, ing["canonical_name"])
        )
        if price_row:
            price = float(price_row[0])
            unit = price_row[1]
            total += price
            items_priced.append({
                "display_name": ing["display_name"],
                "price": round(price, 2),
                "unit": unit
            })
        else:
            no_price.append(ing["canonical_name"])

    return jsonify({
        "store": store,
        "recipe_name": recipe["name"],
        "total": round(total, 2),
        "items_priced": items_priced,
        "no_price_data": sorted(set(no_price))
    })

