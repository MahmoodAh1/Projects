            plan["Dessert"] = {"id": did, "name": dr["name"], "cuisine": dr["cuisine"]}
            if user_id:
                execute("INSERT INTO history(user_id,recipe_id) VALUES(%s,%s)", (user_id, did))
        else:
            plan["Dessert"] = {"id": None, "name": "(none found)", "cuisine": ""}
    else:
        plan["Dessert"] = None

    return jsonify(plan)

