@app.route("/api/shopping-list/<int:recipe_id>")
def shopping_list(recipe_id):
    user_id = session.get("user_id")
    pantry_lc = set()
    if user_id:
        rows = fetch_all("SELECT LOWER(canonical_name) FROM pantry_items WHERE user_id=%s", (user_id,))
        pantry_lc = {r[0] for r in rows}

    # Accept additional typed ingredients via query param (from ingredient match flow)
    extra_have = request.args.get("have_lc", "")
    if extra_have:
        for item in extra_have.split(","):
            item = item.strip()
            if item:
                pantry_lc.add(item)

    recipe = load_recipe_full(recipe_id)
    if not recipe: return jsonify({"error": "Not found"}), 404

    by_cat = {}; have = []
    for ing in recipe["ingredients"]:
        if to_lower(ing["canonical_name"]) in pantry_lc:
            have.append({"display_name": ing["display_name"], "qty_display": ing["qty_display"]})
        else:
            cat = ing["category"] or "Other"
            by_cat.setdefault(cat, []).append({"display_name": ing["display_name"], "qty_display": ing["qty_display"]})

    return jsonify({"need_grouped": {c: v for c, v in sorted(by_cat.items())}, "have": have})

